{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "host": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Host",
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "apiKey": "none"
      },
      "models": {
        "qwen/qwen3.5-9b": {
          "name": "Host"
        }
      }
    }
  },
  "model": "host/qwen/qwen3.5-9b",
  "mcp": {
    "searxng": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@kevinwatt/mcp-server-searxng"
      ],
    "environment": {
        "SEARXNG_INSTANCES": "http://searxng:8080",
        "SEARXNG_USER_AGENT": "MCP-SearXNG/1.0",
        "NODE_TLS_REJECT_UNAUTHORIZED": "1"
      }
    },
    "icloud-calendar": {
      "type": "remote",
      "url": "http://icloud-mcp:8000/mcp",
      "enabled": true
    }
  },
  "shell": "/bin/sh"
}
